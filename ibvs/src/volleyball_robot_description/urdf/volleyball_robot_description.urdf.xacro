<?xml version="1.0" encoding="utf-8"?>

<robot name="volleyball_robot_description"
    xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="delta_arm_xyz" default="0.051 0 0.191"/>
    <xacro:arg name="delta_arm_rpy" default="-3.1416 0 0"/>
    <xacro:arg name="cam_xyz" default="-0.202 -0.0125 1.004"/>
    <xacro:arg name="cam_rpy" default="0 0 0"/>
    <xacro:arg name="strike_point_xyz" default="0.14853 0 0.362.34"/>
    <xacro:arg name="strike_point_rpy" default="0 0 0"/>

    <link name="odom"/>

    <joint name="base_joint" type="floating">
        <parent link="odom" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                filename="package://volleyball_robot_description/meshes/base_link.STL" />
            </geometry>
            <material
                name="">
                <color
                rgba="0.75294 0.75294 0.75294 1" />
            </material>
        </visual>
    </link>

    <link name="delta_arm_link">
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0.5841617 0" />
            <geometry>
                <mesh
                filename="package://volleyball_robot_description/meshes/delta_arm_link.STL" />
            </geometry>
            <material
                name="">
                <color
                rgba="0.79216 0.81961 0.93333 1" />
            </material>
        </visual>
    </link>

    <joint name="delta_arm_joint" type="continuous">
        <origin
        xyz="$(arg delta_arm_xyz)"
        rpy="$(arg delta_arm_rpy)" />
        <parent link="base_link" />
        <child link="delta_arm_link" />
        <axis
        xyz="0 1 0" />
    </joint>
    
    <link name="camera_link">
        <visual>
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
            <geometry>
                <mesh
                filename="package://volleyball_robot_description/meshes/camera_link.STL" />
            </geometry>
            <material
                name="">
                <color
                rgba="1 1 1 1" />
            </material>
        </visual>
    </link>

    <joint name="camera_joint" type="fixed">
        <origin
        xyz="$(arg cam_xyz)"
        rpy="$(arg cam_rpy)" />
        <parent link="strike_point" />
        <child link="camera_link" />
        <axis
        xyz="0 0 0" />
    </joint>

    <link name="strike_point"/>

    <joint name="strike_point_joint" type="fixed">
        <origin
        xyz="$(arg strike_point_xyz)"
        rpy="$(arg strike_point_rpy)" />
        <parent link="base_link" />
        <child link="strike_point" />
        <axis xyz="0 0 0" />
    </joint>
</robot>
